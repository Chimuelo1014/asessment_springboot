        {
            "name": "Credit Applications",
            "item": [
                {
                    "name": "Create Credit Application",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 201\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "pm.test(\"Application created with PENDING status\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.status).to.eql('PENDING');",
                                    "    pm.environment.set(\"application_id\", jsonData.id);",
                                    "});",
                                    "",
                                    "pm.test(\"Calculate expected monthly payment\", function() {",
                                    "    const amount = 10000000;",
                                    "    const months = 36;",
                                    "    const rate = 12.5 / 12 / 100;",
                                    "    ",
                                    "    const numerator = rate * Math.pow(1 + rate, months);",
                                    "    const denominator = Math.pow(1 + rate, months) - 1;",
                                    "    const payment = amount * (numerator / denominator);",
                                    "    ",
                                    "    console.log(\"Expected monthly payment:\", payment);",
                                    "    pm.expect(payment).to.be.closeTo(334536, 1000);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
